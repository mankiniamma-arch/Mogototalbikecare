import React, { useState } from 'react';
import { Calendar, Clock, Wrench, Navigation, CheckCircle, User, MapPin } from 'lucide-react';

export default function App() {
  // --- EXISTING SECURED STATE ---
  const [selectedService, setSelectedService] = useState({ name: 'Standard Foam Wash', price: 69 });
  const [customerName, setCustomerName] = useState('');
  const [customerPhone, setCustomerPhone] = useState('');
  const [customerAddress, setCustomerAddress] = useState('');
  
  // --- DUTY HOURS: 08:00 AM TO 08:00 PM ---
  const [selectedArea, setSelectedArea] = useState('Guwahati - Central');
  const [selectedSlot, setSelectedSlot] = useState('');
  const [activeTab, setActiveTab] = useState('customer'); // 'customer' or 'mechanic'
  const [bookingConfirmed, setBookingConfirmed] = useState(false);

  // Guwahati Service Areas
  const guwahatiAreas = [
    'Guwahati - Central (Pan Bazaar / Paltan Bazaar)',
    'Dispur / GS Road',
    'Chandmari / Zoo Road',
    'Ulubari / Rehabari',
    'Six Mile / Basistha'
  ];

  // Duty Hours (08:00 AM to 08:00 PM) Slot Grid Matrix with Travel Gaps
  const [timeSlots, setTimeSlots] = useState([
    { id: 1, time: '08:00 AM - 09:30 AM', status: 'AVAILABLE' },
    { id: 2, time: '10:00 AM - 11:30 AM', status: 'AVAILABLE' },
    { id: 3, time: '12:00 PM - 01:30 PM', status: 'AVAILABLE' },
    { id: 4, time: '02:30 PM - 04:00 PM', status: 'AVAILABLE' },
    { id: 5, time: '04:30 PM - 06:00 PM', status: 'AVAILABLE' },
    { id: 6, time: '06:30 PM - 08:00 PM', status: 'AVAILABLE' },
  ]);

  // Mechanic Job Portal with GPS Map Link
  const [mechanicJobs, setMechanicJobs] = useState([
    {
      id: 'MOGO-101',
      name: customerName || 'Rahul Sharma',
      phone: customerPhone || '9876543210',
      address: customerAddress || 'GS Road, Guwahati',
      latLongUrl: 'https://maps.google.com/?q=26.1445,91.7362', // GPS Navigation
      slot: selectedSlot || '10:00 AM - 11:30 AM',
      status: 'Pending Confirmation'
    }
  ]);

  const handleSlotBooking = (e) => {
    e.preventDefault();
    if (!selectedSlot) {
      alert('कृपया ड्यूटी आवर्स में से कोई खाली समय स्लॉट (Time Slot) चुनें!');
      return;
    }
    setBookingConfirmed(true);
    
    // Mark the selected slot as BOOKED instantly
    setTimeSlots(timeSlots.map(slot => 
      slot.time === selectedSlot ? { ...slot, status: 'BOOKED' } : slot
    ));
  };

  const confirmMechanicVisit = (jobId) => {
    setMechanicJobs(mechanicJobs.map(j => j.id === jobId ? { ...j, status: 'Confirmed / Out for Service' } : j));
    alert('बुकिंग कन्फर्म कर दी गई है! मैकेनिक GPS रूट के साथ रवाना हो रहा है।');
  };

  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 font-sans">
      {/* Header / Brand Logo Secured */}
      <header className="bg-slate-900 text-white p-4 shadow-md flex justify-between items-center">
        <div className="flex items-center space-x-2">
          <Wrench className="h-6 w-6 text-yellow-400" />
          <h1 className="text-xl font-bold tracking-wide">MOGO Total Bike Care <span className="text-xs text-yellow-400 font-normal">Guwahati</span></h1>
        </div>
        <div className="space-x-2">
          <button 
            onClick={() => setActiveTab('customer')} 
            className={`px-3 py-1.5 rounded text-sm font-medium transition ${activeTab === 'customer' ? 'bg-yellow-500 text-slate-900' : 'bg-slate-800 text-white'}`}>
            Customer Portal
          </button>
          <button 
            onClick={() => setActiveTab('mechanic')} 
            className={`px-3 py-1.5 rounded text-sm font-medium transition ${activeTab === 'mechanic' ? 'bg-yellow-500 text-slate-900' : 'bg-slate-800 text-white'}`}>
            Mechanic Portal (GPS)
          </button>
        </div>
      </header>

      <main className="max-w-4xl mx-auto p-4 md:p-6">
        {activeTab === 'customer' ? (
          <div>
            <div className="bg-gradient-to-r from-blue-600 to-indigo-700 text-white rounded-2xl p-6 shadow-lg mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
              <div>
                <span className="bg-yellow-400 text-slate-900 text-xs font-bold px-2.5 py-1 rounded-full uppercase">Doorstep Service</span>
                <h2 className="text-2xl md:text-3xl font-extrabold mt-2">Professional High-Pressure Bike Wash</h2>
                <p className="text-blue-100 mt-1 text-sm">Guwahati doorstep service starting at just <span className="text-yellow-300 font-bold text-lg">₹69</span></p>
              </div>
              <div className="bg-blue-800/60 border border-blue-400/30 p-3 rounded-xl text-xs space-y-1">
                <p className="font-bold text-yellow-300 flex items-center gap-1">
                  <Clock className="h-3.5 w-3.5" /> Duty Hours Active
                </p>
                <p className="text-blue-100">08:00 AM – 08:00 PM (Daily)</p>
              </div>
            </div>

            {!bookingConfirmed ? (
              <form onSubmit={handleSlotBooking} className="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 space-y-6">
                <h3 className="text-lg font-bold text-slate-900 flex items-center gap-2">
                  <Calendar className="h-5 w-5 text-blue-600" /> Duty Hours Slot Booking (08:00 AM - 08:00 PM)
                </h3>

                <div>
                  <label className="block text-sm font-medium text-slate-700 mb-1">Select Area in Guwahati</label>
                  <select 
                    value={selectedArea} 
                    onChange={(e) => setSelectedArea(e.target.value)}
                    className="w-full p-3 border rounded-xl bg-slate-50 text-sm">
                    {guwahatiAreas.map((area, idx) => (
                      <option key={idx} value={area}>{area}</option>
                    ))}
                  </select>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm font-medium text-slate-700 mb-1">Your Name</label>
                    <input 
                      type="text" required 
                      value={customerName} onChange={(e) => setCustomerName(e.target.value)}
                      placeholder="e.g. Rahul Sharma" 
                      className="w-full p-3 border rounded-xl text-sm" />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-700 mb-1">Phone Number</label>
                    <input 
                      type="tel" required 
                      value={customerPhone} onChange={(e) => setCustomerPhone(e.target.value)}
                      placeholder="e.g. 9876543210" 
                      className="w-full p-3 border rounded-xl text-sm" />
                  </div>
                </div>

                <div>
                  <label className="block text-sm font-medium text-slate-700 mb-1">Complete Address</label>
                  <textarea required rows="2"
                    value={customerAddress} onChange={(e) => setCustomerAddress(e.target.value)}
                    placeholder="House No, Street, Landmark in Guwahati" 
                    className="w-full p-3 border rounded-xl text-sm"></textarea>
                </div>

                {/* Duty Hours Slot Grid */}
                <div>
                  <label className="block text-sm font-medium text-slate-700 mb-2 flex items-center gap-1">
                    <Clock className="h-4 w-4 text-blue-600" /> Choose Duty Time Slot (Single Pressure Washer Lock)
                  </label>
                  <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
                    {timeSlots.map((slot) => {
                      const isAvailable = slot.status === 'AVAILABLE';
                      const isSelected = selectedSlot === slot.time;
                      
                      return (
                        <button
                          type="button"
                          key={slot.id}
                          disabled={!isAvailable}
                          onClick={() => setSelectedSlot(slot.time)}
                          className={`p-3.5 rounded-xl border text-center transition flex flex-col items-center justify-center ${
                            isSelected 
                              ? 'bg-blue-600 text-white border-blue-600 shadow-md ring-2 ring-blue-300' 
                              : isAvailable 
                              ? 'bg-emerald-50 hover:bg-emerald-100 text-emerald-900 border-emerald-200 cursor-pointer' 
                              : 'bg-rose-50 text-rose-400 border-rose-200 cursor-not-allowed opacity-75'
                          }`}>
                          <span className="text-xs md:text-sm font-bold">{slot.time}</span>
                          <span className={`text-[10px] mt-1 font-semibold px-2 py-0.5 rounded-full ${
                            isSelected ? 'bg-blue-700 text-white' : isAvailable ? 'bg-emerald-200 text-emerald-800' : 'bg-rose-200 text-rose-800'
                          }`}>
                            {isSelected ? 'SELECTED' : isAvailable ? 'AVAILABLE' : 'ALREADY BOOKED'}
                          </span>
                        </button>
                      );
                    })}
                  </div>
                </div>

                <div className="border-t pt-4 flex justify-between items-center">
                  <div>
                    <p className="text-xs text-slate-500">Service Package</p>
                    <p className="text-lg font-extrabold text-slate-900">₹69 <span className="text-xs font-normal text-green-600">(Pay on Service / Manual)</span></p>
                  </div>
                  <button 
                    type="submit"
                    className="bg-yellow-500 hover:bg-yellow-400 text-slate-900 font-bold px-6 py-3 rounded-xl shadow transition">
                    Confirm Slot & Book
                  </button>
                </div>
              </form>
            ) : (
              <div className="bg-white rounded-2xl p-8 text-center shadow-sm space-y-4">
                <CheckCircle className="h-16 w-16 text-green-500 mx-auto" />
                <h3 className="text-2xl font-bold text-slate-900">Slot Booked Successfully!</h3>
                <p className="text-slate-600 text-sm">आपका ड्यूटी स्लॉट ({selectedSlot}) सुरक्षित रूप से लॉक हो चुका है।</p>
                <button 
                  onClick={() => setBookingConfirmed(false)}
                  className="mt-4 bg-slate-900 text-white px-6 py-2 rounded-xl text-sm font-medium">
                  Book Another Slot
                </button>
              </div>
            )}
          </div>
        ) : (
          /* MECHANIC PORTAL WITH GPS */
          <div className="space-y-6">
            <div className="bg-slate-900 text-white rounded-2xl p-6 shadow-lg">
              <h3 className="text-xl font-bold flex items-center gap-2">
                <Wrench className="h-5 w-5 text-yellow-400" /> Mechanic Job Portal (Guwahati)
              </h3>
              <p className="text-slate-400 text-sm mt-1">Duty Hours: 08:00 AM - 08:00 PM | Live GPS Map Navigation</p>
            </div>

            <div className="space-y-4">
              {mechanicJobs.map((job) => (
                <div key={job.id} className="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                  <div className="space-y-2">
                    <span className="bg-blue-100 text-blue-800 text-xs font-bold px-2.5 py-1 rounded-full">{job.id}</span>
                    <h4 className="font-bold text-lg text-slate-900 flex items-center gap-2">
                      <User className="h-4 w-4 text-slate-500" /> {job.name} ({job.phone})
                    </h4>
                    <p className="text-sm text-slate-600 flex items-start gap-1">
                      <MapPin className="h-4 w-4 text-red-500 shrink-0 mt-0.5" /> {job.address}
                    </p>
                    <p className="text-xs text-slate-500 font-medium">Duty Slot: <span className="text-blue-600 font-bold">{job.slot}</span></p>
                    <p className="text-xs font-semibold text-amber-600">Status: {job.status}</p>
                  </div>

                  <div className="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
                    <a 
                      href={job.latLongUrl} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      className="flex items-center justify-center gap-2 bg-blue-50 text-blue-600 hover:bg-blue-100 font-semibold px-4 py-2.5 rounded-xl text-sm transition border border-blue-200">
                      <Navigation className="h-4 w-4" /> Open GPS Map
                    </a>

                    <button 
                      onClick={() => confirmMechanicVisit(job.id)}
                      className="bg-green-600 hover:bg-green-500 text-white font-bold px-5 py-2.5 rounded-xl text-sm shadow transition">
                      Confirm Visit
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </main>
    </div>
  );
}
