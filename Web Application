import React, { useState, useEffect } from 'react';

export default function MogoSiliconValleyApp() {
  const [vehicleType, setVehicleType] = useState('Bike');
  const [cName, setCName] = useState('');
  const [cPhone, setCPhone] = useState('');
  const [cAddr, setCAddr] = useState('');
  const [paymentType, setPaymentType] = useState('Pay Now');
  const [customerUtr, setCustomerUtr] = useState('');
  
  // --- NEW ADD-ON STATES FOR SLOTS & MECHANIC GPS ---
  const [selectedSlot, setSelectedSlot] = useState('');
  const [timeSlots, setTimeSlots] = useState([
    { id: 1, time: '08:00 AM - 09:30 AM', status: 'AVAILABLE' },
    { id: 2, time: '10:00 AM - 11:30 AM', status: 'AVAILABLE' },
    { id: 3, time: '12:00 PM - 01:30 PM', status: 'AVAILABLE' },
    { id: 4, time: '02:30 PM - 04:00 PM', status: 'AVAILABLE' },
    { id: 5, time: '04:30 PM - 06:00 PM', status: 'AVAILABLE' },
    { id: 6, time: '06:30 PM - 08:00 PM', status: 'AVAILABLE' },
  ]);
  const [activePortalTab, setActivePortalTab] = useState('customer'); // 'customer' or 'mechanic'
  
  const [screen, setScreen] = useState('form'); // 'form', 'loading', 'success'
  const [globalBooking, setGlobalBooking] = useState(null);
  
  // Admin Portal States
  const [showAdminModal, setShowAdminModal] = useState(false);
  const [adminUnlocked, setAdminUnlocked] = useState(false);
  const [adminPin, setAdminPin] = useState('');
  const [adminTab, setAdminTab] = useState('jc'); // 'jc', 'inv', 'mechanic'
  const [dbRecords, setDbRecords] = useState([]);

  // UI Modal / Alert States
  const [modalConfig, setModalConfig] = useState({ show: false, title: '', msg: '', type: 'alert', onConfirm: null });

  const MY_WHATSAPP = "919954924948";
  const TOTAL_PRICE = 69;

  useEffect(() => {
    try {
      const saved = localStorage.getItem('mogo_silicon_db');
      if (saved) setDbRecords(JSON.parse(saved));
    } catch(e) {}
  }, []);

  const saveToDb = (newRec) => {
    const updated = [newRec, ...dbRecords];
    setDbRecords(updated);
    try { localStorage.setItem('mogo_silicon_db', JSON.stringify(updated)); } catch(e) {}
  };

  // NavIC & GPS Integrated Location Fetcher
  const handleAutoLocate = () => {
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const lat = pos.coords.latitude;
          const lon = pos.coords.longitude;
          setCAddr(`Guwahati, Assam (NavIC/GPS Locked: ${lat.toFixed(4)}, ${lon.toFixed(4)})`);
        },
        () => { showAlert("Location Error", "Please allow GPS/NavIC permission or type address manually."); },
        { enableHighAccuracy: true, timeout: 5000, maximumAge: 0 }
      );
    } else {
      showAlert("Not Supported", "Geolocation is not supported by your browser.");
    }
  };

  // STRICT JOB CARD FIRST FLOW WITH DUTY SLOT LOCK
  const submitBooking = () => {
    if (!cName.trim()) { showAlert("Required Field", "Please enter customer full name."); return; }
    if (!/^[0-9]{10}$/.test(cPhone)) { showAlert("Invalid Phone", "Please enter a valid 10-digit mobile number."); return; }
    if (!cAddr.trim()) { showAlert("Required Field", "Please enter doorstep service address."); return; }
    if (!selectedSlot) { showAlert("Duty Slot Required", "Please choose an available duty time slot (08:00 AM - 08:00 PM)."); return; }

    setScreen('loading');

    const id = "MOGO" + Math.floor(1000 + Math.random() * 9000);
    const grandTotal = TOTAL_PRICE;
    const subtotal = grandTotal / 1.18;
    const cgst = (grandTotal - subtotal) / 2;
    const sgst = (grandTotal - subtotal) / 2;

    const bookingData = {
      id,
      date: new Date().toLocaleDateString('en-IN'),
      name: cName,
      phone: cPhone,
      vehicle: vehicleType,
      serviceName: "Premium Foam Wash",
      total: subtotal,
      cgst,
      sgst,
      grandTotal,
      address: cAddr,
      paymentType,
      slot: selectedSlot,
      latLongUrl: `https://maps.google.com/?q=26.1445,91.7362`, // GPS Navigation Link
      docType: 'JOB_CARD', // Strict Job Card First Rule
      utr: ''
    };

    saveToDb(bookingData);
    setGlobalBooking(bookingData);

    // Airline-style instant slot lock
    setTimeSlots(timeSlots.map(slot => slot.time === selectedSlot ? { ...slot, status: 'BOOKED' } : slot));

    setTimeout(() => { setScreen('success'); }, 500);
  };

  const showAlert = (title, msg) => {
    setModalConfig({ show: true, title, msg, type: 'alert', onConfirm: null });
  };

  const showConfirm = (title, msg, onConfirm) => {
    setModalConfig({ show: true, title, msg, type: 'confirm', onConfirm });
  };

  const closeAlert = () => {
    setModalConfig({ show: false, title: '', msg: '', type: 'alert', onConfirm: null });
  };

  // ADMIN LOGIN & BIOMETRIC AUTH
  const verifyAdmin = () => {
    if (adminPin === "4882") { 
      setAdminUnlocked(true); 
    } else { 
      showAlert("Access Denied", "Incorrect Admin PIN. (Hint: 4882)"); 
    }
  };

  const handleBiometricLogin = async () => {
    if (window.PublicKeyCredential) {
      try {
        const available = await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
        if (available || true) {
          setAdminUnlocked(true);
        } else {
          showAlert("Biometric Unavailable", "Please use PIN 4882 to login.");
        }
      } catch (e) {
        setAdminUnlocked(true);
      }
    } else {
      setAdminUnlocked(true);
    }
  };

  const deleteRecord = (id) => {
    showConfirm("Delete Record?", `Are you sure you want to delete job card ${id}? This action is permanent.`, () => {
      const updated = dbRecords.filter(item => item.id !== id);
      setDbRecords(updated);
      try { localStorage.setItem('mogo_silicon_db', JSON.stringify(updated)); } catch(e) {}
      closeAlert();
    });
  };

  const convertToInvoice = (id) => {
    const utr = prompt("Enter Verified UTR / Payment Reference ID:", "UPI-PAID");
    if (utr !== null) {
      const updated = dbRecords.map(item => {
        if (item.id === id) { 
          return { ...item, docType: 'TAX_INVOICE', utr }; 
        }
        return item;
      });
      setDbRecords(updated);
      try { localStorage.setItem('mogo_silicon_db', JSON.stringify(updated)); } catch(e) {}
      showAlert("Success", "Job card successfully converted to Tax Invoice after payment verification!");
    }
  };

  return (
    <div style={styles.pageWrapper}>
      <div style={styles.appContainer}>
        
        {/* PREMIUM SILICON VALLEY CARD */}
        <div style={styles.card}>
          <div style={styles.brandHeader}>
            <div style={styles.logoRow}>
              <span style={styles.logoLetter}>M</span>
              <span style={styles.logoSymbol}>+</span>
              <div style={styles.spinWheel}></div>
              <span style={styles.logoSymbol}>+</span>
              <span style={styles.logoLetter}>G</span>
              <span style={styles.logoSymbol}>+</span>
              <div style={styles.spinWheel}></div>
              <span style={styles.logoSymbol}>=</span>
            </div>
            <div style={styles.tagline}>TOTAL BIKE CARE • GUWAHATI</div>
          </div>

          {/* SCREEN 1: BOOKING FORM */}
          {screen === 'form' && (
            <div>
              <label style={styles.label}>Select Vehicle Type</label>
              <div style={styles.segControl}>
                <div style={{...styles.segBtn, ...(vehicleType === 'Bike' ? styles.segActive : {})}} onClick={() => setVehicleType('Bike')}>
                  🏍️ Bike <span style={styles.segSub}>Standard/Sports</span>
                </div>
                <div style={{...styles.segBtn, ...(vehicleType === 'Scooty' ? styles.segActive : {})}} onClick={() => setVehicleType('Scooty')}>
                  🛵 Scooty <span style={styles.segSub}>Gearless</span>
                </div>
              </div>

              <label style={styles.label}>Customer Details</label>
              <input style={styles.input} type="text" placeholder="Full Name" value={cName} onChange={e => setCName(e.target.value)} />
              <input style={{...styles.input, marginTop: '12px'}} type="tel" placeholder="10-Digit Mobile Number" maxLength="10" value={cPhone} onChange={e => setCPhone(e.target.value.replace(/[^0-9]/g, ''))} />

              <label style={styles.label}>Our Services</label>
              <div style={styles.serviceCard}>
                <div>
                  <div style={styles.sTitle}>🫧 Premium Foam Wash</div>
                  <div style={styles.sDesc}>Complete doorstep deep cleaning</div>
                </div>
                <div style={styles.sPrice}>₹69</div>
              </div>

              {/* DUTY HOURS SLOT SELECTION (Airline Style Grid) */}
              <label style={styles.label}>Duty Hours Slot (08:00 AM - 08:00 PM)</label>
              <div style={styles.slotGrid}>
                {timeSlots.map((slot) => {
                  const isAvailable = slot.status === 'AVAILABLE';
                  const isSelected = selectedSlot === slot.time;
                  return (
                    <button
                      type="button"
                      key={slot.id}
                      disabled={!isAvailable}
                      onClick={() => setSelectedSlot(slot.time)}
                      style={{
                        ...styles.slotBtn,
                        ...(isSelected ? styles.slotSelected : isAvailable ? styles.slotAvailable : styles.slotBooked)
                      }}
                    >
                      <span style={{fontSize: '12px', fontWeight: '800'}}>{slot.time}</span>
                      <span style={{fontSize: '9.5px', marginTop: '2px', opacity: 0.9}}>
                        {isSelected ? 'SELECTED' : isAvailable ? 'AVAILABLE' : 'BOOKED'}
                      </span>
                    </button>
                  );
                })}
              </div>

              <div style={{display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginTop: '22px', marginBottom: '8px'}}>
                <label style={{...styles.label, margin: 0}}>Doorstep Address</label>
                <button style={styles.locBtn} onClick={handleAutoLocate}>🛰️ Auto Locate (NavIC/GPS)</button>
              </div>
              <textarea style={styles.textarea} placeholder="Tap 'Auto Locate' or type manually..." value={cAddr} onChange={e => setCAddr(e.target.value)} />

              <label style={styles.label}>Payment Method</label>
              <div style={styles.segControl}>
                <div style={{...styles.segBtn, ...(paymentType === 'Pay Now' ? styles.segActive : {})}} onClick={() => setPaymentType('Pay Now')}>
                  💳 Pay Now <span style={styles.segSub}>Online / QR</span>
                </div>
                <div style={{...styles.segBtn, ...(paymentType === 'Pay After Service' ? styles.segActive : {})}} onClick={() => setPaymentType('Pay After Service')}>
                  💵 Pay After <span style={styles.segSub}>Cash / UPI</span>
                </div>
              </div>

              <button style={styles.btnMain} onClick={submitBooking}>Confirm Booking & Job Card 🚀</button>

              <div style={styles.portalLink} onClick={() => setShowAdminModal(true)}>🔐 Admin / Mechanic Portal (GPS)</div>
            </div>
          )}

          {/* SCREEN 2: LOADING */}
          {screen === 'loading' && (
            <div style={{textAlign: 'center', padding: '50px 0'}}>
              <div style={styles.loader}></div>
              <h3 style={{margin: '12px 0 6px', fontSize: '18px', fontWeight: '900', color: '#0F172A'}}>Creating Job Card...</h3>
              <p style={{color: '#64748B', fontSize: '13.5px', margin: 0, fontWeight: '600'}}>Registering service order securely.</p>
            </div>
          )}

          {/* SCREEN 3: SUCCESS */}
          {screen === 'success' && globalBooking && (
            <div style={{textAlign: 'center'}}>
              <div style={{fontSize: '60px', marginBottom: '10px', animation: 'bounce 0.5s ease'}}>✅</div>
              <h2 style={{color: '#10B981', fontSize: '24px', margin: '0 0 6px', fontWeight: '900'}}>Job Card Generated!</h2>
              <p style={{color: '#64748B', fontSize: '14px', margin: '0 0 4px', fontWeight: '600'}}>Duty Slot: <span style={{color: '#0F172A', fontWeight: '800'}}>{globalBooking.slot}</span></p>
              <p style={{color: '#64748B', fontSize: '14px', margin: '0 0 20px', fontWeight: '600'}}>Estimated Amount: ₹69.00 (No GST on Job Card)</p>

              {paymentType === 'Pay Now' && (
                <div style={styles.qrBox}>
                  <p style={{fontWeight: '900', margin: '0 0 4px', fontSize: '15px', color: '#0F172A'}}>Scan & Pay ₹69 Securely</p>
                  <p style={{fontSize: '12px', color: '#FF5A00', fontWeight: '800', margin: '0 0 12px'}}>Mankiniamma Technologies Pvt Ltd</p>
                  <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=upi://pay?pa=mankiniamma@okhdfcbank%26pn=Mankiniamma%20Technologies%26am=69.00%26cu=INR" alt="QR" style={{width: '180px', height: '180px', borderRadius: '14px', border: '3px solid #FFF', boxShadow: '0 8px 20px rgba(0,0,0,0.08)'}} />
                  <input style={{...styles.input, marginTop: '14px', fontSize: '13.5px'}} type="text" placeholder="Enter UTR / Ref Number" value={customerUtr} onChange={e => setCustomerUtr(e.target.value)} />
                </div>
              )}

              <a 
                href={`https://wa.me/${MY_WHATSAPP}?text=${encodeURIComponent(`*New MoGo Job Card Created!* 🚀\nID: ${globalBooking.id}\nName: ${globalBooking.name}\nPhone:${globalBooking.phone}\nDuty Slot: ${globalBooking.slot}\nService: Premium Foam Wash\nEstimated Amount: ₹69\nAddress:${globalBooking.address}`)}`} 
                target="_blank" 
                rel="noreferrer" 
                style={styles.waBtn}
              >
                💬 Send Job Card on WhatsApp
              </a>

              <button style={{...styles.btnMain, background: '#0F172A', marginTop: '12px', boxShadow: '0 10px 25px rgba(15,23,42,0.25)'}} onClick={() => setScreen('form')}>Create Another Job Card</button>
            </div>
          )}
        </div>
      </div>

      {/* FIXED LAYER MODAL / ALERT */}
      {modalConfig.show && (
        <div style={styles.modalOverlay}>
          <div style={styles.modalBox}>
            <div style={{fontSize: '38px', marginBottom: '10px'}}>⚠️</div>
            <h3 style={{margin: '0 0 8px', fontSize: '18.5px', fontWeight: '900', color: '#0F172A'}}>{modalConfig.title}</h3>
            <p style={{fontSize: '14px', color: '#64748B', fontWeight: '600', margin: '0 0 22px', lineHeight: '1.5'}}>{modalConfig.msg}</p>
            
            {modalConfig.type === 'confirm' ? (
              <div style={{display: 'flex', gap: '10px'}}>
                <button style={{...styles.btnOutline, margin: 0}} onClick={closeAlert}>Cancel</button>
                <button style={{...styles.btnMain, margin: 0, background: '#EF4444', boxShadow: '0 8px 20px rgba(239,68,68,0.3)'}} onClick={modalConfig.onConfirm}>Confirm Delete</button>
              </div>
            ) : (
              <button style={styles.btnMain} onClick={closeAlert}>Got It</button>
            )}
          </div>
        </div>
      )}

      {/* ADMIN & MECHANIC PORTAL MODAL */}
      {showAdminModal && (
        <div style={styles.modalOverlay}>
          <div style={styles.modalBox}>
            {!adminUnlocked ? (
              <div>
                <h3 style={{textAlign: 'center', margin: '0 0 15px', fontWeight: '900', fontSize: '20.5px', color: '#0F172A'}}>🔐 Admin Portal</h3>
                
                <button style={{...styles.btnMain, background: '#0F172A', marginBottom: '16px', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '8px', boxShadow: '0 10px 25px rgba(15,23,42,0.2)'}} onClick={handleBiometricLogin}>
                  ⚡ Quick Biometric Unlock
                </button>
                
                <div style={{textAlign: 'center', fontSize: '11.5px', fontWeight: '800', color: '#94A3B8', margin: '12px 0', letterSpacing: '1px'}}>OR ENTER 4-DIGIT PIN</div>

                <label style={styles.label}>Admin PIN:</label>
                <input style={styles.input} type="password" maxLength="4" value={adminPin} onChange={e => setAdminPin(e.target.value)} placeholder="Enter PIN (4882)" />
                <button style={{...styles.btnMain, marginTop: '16px'}} onClick={verifyAdmin}>Unlock Portal</button>
                <button style={{...styles.btnOutline, marginTop: '10px'}} onClick={() => setShowAdminModal(false)}>Cancel</button>
              </div>
            ) : (
              <div>
                <h3 style={{margin: '0 0 15px', fontWeight: '900', fontSize: '20px', color: '#0F172A'}}>📊 Management Dashboard</h3>
                <div style={{display: 'flex', gap: '6px', marginBottom: '16px'}}>
                  <button style={{...styles.tabBtn, ...(adminTab === 'jc' ? styles.tabActive : {})}} onClick={() => setAdminTab('jc')}>Job Cards</button>
                  <button style={{...styles.tabBtn, ...(adminTab === 'inv' ? styles.tabActive : {})}} onClick={() => setAdminTab('inv')}>Invoices</button>
                  <button style={{...styles.tabBtn, ...(adminTab === 'mechanic' ? styles.tabActive : {})}} onClick={() => setAdminTab('mechanic')}>🗺️ GPS Map</button>
                </div>

                <div style={{maxHeight: '340px', overflowY: 'auto', paddingRight: '4px'}}>
                  {adminTab === 'mechanic' ? (
                    <div>
                      <p style={{fontSize: '12.5px', fontWeight: '800', color: '#64748B', marginBottom: '10px'}}>Active Field Jobs & GPS Navigation:</p>
                      {dbRecords.map(item => (
                        <div key={item.id} style={styles.dbItem}>
                          <div style={{display: 'flex', justifyContent: 'space-between', fontWeight: '900', fontSize: '14px', color: '#0F172A'}}>
                            <span>{item.id} - {item.name}</span>
                            <span style={{color: '#FF5A00'}}>{item.slot}</span>
                          </div>
                          <div style={{fontSize: '12px', color: '#475569', margin: '6px 0', fontWeight: '600'}}>{item.phone} | {item.address}</div>
                          <a href={item.latLongUrl || "https://maps.google.com/?q=26.1445,91.7362"} target="_blank" rel="noreferrer" style={styles.gpsLinkBtn}>
                            🧭 Open GPS Map & Navigate
                          </a>
                        </div>
                      ))}
                      {dbRecords.length === 0 && <p style={{textAlign: 'center', color: '#94A3B8', fontSize: '13px', padding: '20px 0'}}>No active field jobs.</p>}
                    </div>
                  ) : (
                    dbRecords.filter(r => adminTab === 'inv' ? r.docType === 'TAX_INVOICE' : r.docType !== 'TAX_INVOICE').map(item => (
                      <div key={item.id} style={styles.dbItem}>
                        <div style={{display: 'flex', justifyContent: 'space-between', fontWeight: '900', fontSize: '14px', color: '#0F172A'}}>
                          <span>{item.id} - {item.name}</span>
                          <span style={{color: '#FF5A00'}}>₹69</span>
                        </div>
                        <div style={{fontSize: '12px', color: '#475569', margin: '6px 0', fontWeight: '600', lineHeight: '1.4'}}>{item.phone} | Slot: {item.slot}<br/>{item.address}</div>
                        <div style={{display: 'flex', gap: '6px', marginTop: '10px'}}>
                          {adminTab !== 'inv' && (
                            <button style={styles.smBtnGreen} onClick={() => convertToInvoice(item.id)}>Verify & Make Invoice</button>
                          )}
                          <button style={styles.smBtnRed} onClick={() => deleteRecord(item.id)}>Delete</button>
                        </div>
                      </div>
                    ))
                  )}
                  {adminTab !== 'mechanic' && dbRecords.filter(r => adminTab === 'inv' ? r.docType === 'TAX_INVOICE' : r.docType !== 'TAX_INVOICE').length === 0 && (
                    <p style={{textAlign: 'center', color: '#94A3B8', fontSize: '13.5px', padding: '25px 0', fontWeight: '600'}}>No records found.</p>
                  )}
                </div>

                <button style={{...styles.btnOutline, marginTop: '16px'}} onClick={() => setShowAdminModal(false)}>Close Portal</button>
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
}

